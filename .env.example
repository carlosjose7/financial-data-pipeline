# --- caminhos base (edite aqui OU via variaveis de ambiente / arquivo .env) ---
# Padrao aponta para o OneDrive da tesouraria. Para usar outro local, defina:
#   set EXTRATOS_DIR=C:\caminho\Extratos
#   set OUTPUT_DIR=C:\caminho\ETL
EXTRATOS_DIR=C:\Users\Tesouraria\OneDrive - Igreja Batista em Jardim Ingá\Financeiro\Extratos
OUTPUT_DIR=C:\Users\Tesouraria\OneDrive - Igreja Batista em Jardim Ingá\Financeiro\ETL

# --- comportamento ---
# Incluir Bradesco? (existem arquivos ate 2024; 2025/2026 nao tem Bradesco)
BRADESCO_ENABLED=true
# Tentar ler PDFs do Mercado Pago/Cora/PagSeguro na raiz de Extratos como fallback? (CSV e a fonte primaria)
PDF_FALLBACK_ENABLED=false
