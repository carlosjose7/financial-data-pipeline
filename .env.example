# Copie para `.env` (arquivo local, fora do git) e ajuste os caminhos reais.
EXTRATOS_DIR=C:\Caminho\Para\Financeiro\Extratos
OUTPUT_DIR=C:\Caminho\Para\Financeiro\ETL

# Palavras-chave (separadas por virgula) que identificam contas da propria
# organizacao nos lancamentos. Comparacao sem acento/maiusculas.
# Ex.: IGREJA_KEYWORDS=NOME DA ORGANIZACAO,APELIDO
IGREJA_KEYWORDS=

# --- comportamento ---
# Incluir Bradesco? (no caso real so ha arquivos ate 2024)
BRADESCO_ENABLED=true
# Ler PDFs avulsos na raiz de Extratos como fallback? (CSV e a fonte primaria)
PDF_FALLBACK_ENABLED=false
